export XCURSOR_THEME=Bibata-Modern-Classic
export XCURSOR_SIZE=24
xsetroot -cursor_name left_ptr &

# Compositor leve (cantos arredondados/transparência Spotlight) + agente SPICE + notificações + Polkit
picom --config "$HOME/.config/picom.conf" -b &
spice-vdagent &
dunst &
/usr/bin/lxpolkit &

# Bloqueio automático após 10 min de inatividade e ao suspender
xset s 600 600 &
xss-lock -- /opt/ai-os/spotlight/lock.sh &

# Ícones/pastas reais no ambiente de trabalho (sem painéis nem barras)
gsettings set org.nemo.desktop show-desktop-icons true 2>/dev/null || true
gsettings set org.nemo.desktop computer-icon-visible false 2>/dev/null || true
gsettings set org.nemo.desktop home-icon-visible false 2>/dev/null || true
gsettings set org.nemo.desktop trash-icon-visible false 2>/dev/null || true
gsettings set org.nemo.desktop volumes-visible false 2>/dev/null || true
nemo-desktop &

# Aplica wallpaper dinâmico e arranca Spotlight + gestos touchpad
sleep 1
python3 /opt/ai-os/spotlight/wallpaper.py &
python3 /opt/ai-os/spotlight/spotlight_ui.py &
python3 /opt/ai-os/spotlight/gestures.py &
