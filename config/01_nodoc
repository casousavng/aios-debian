# AI-OS Debian: excluir documentação, manpages, locales não PT/EN e variantes de cursor não usadas
path-exclude=/usr/share/doc/*
path-exclude=/usr/share/man/*
path-exclude=/usr/share/info/*
path-exclude=/usr/share/locale/*
path-include=/usr/share/locale/locale.alias
path-include=/usr/share/locale/pt*
path-include=/usr/share/locale/en*
path-exclude=/usr/share/icons/Bibata-Modern-Amber/*
path-exclude=/usr/share/icons/Bibata-Modern-Ice/*
path-exclude=/usr/share/icons/Bibata-Original-*/*
