[global]
    monitor = 0
    follow = mouse
    width = 340
    height = (0, 120)
    origin = top-right
    offset = (16, 40)
    notification_limit = 3
    padding = 12
    horizontal_padding = 14
    frame_width = 1
    frame_color = "#67e8f9"
    separator_color = frame
    corner_radius = 14
    font = Sans 10
    format = "<b>%s</b>\n%b"
    timeout = 5
    mouse_left_click = close_current

[urgency_low]
    background = "#141922"
    foreground = "#cbd5e1"
    frame_color = "#334155"

[urgency_normal]
    background = "#141922"
    foreground = "#f1f5f9"
    frame_color = "#67e8f9"

[urgency_critical]
    background = "#1f151b"
    foreground = "#fecaca"
    frame_color = "#ef4444"
    timeout = 0
